ANTHROPIC_API_KEY=<your Anthropic API key>

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<copy SUPABASE_SERVICE_ROLE_KEY from `supabase status -o env`>
CROSSBEAM_WORKER_TOKEN=replace-with-the-same-secret-used-by-the-frontend
CROSSBEAM_SANDBOX_CALLBACK_SECRET=replace-with-a-different-long-random-secret
CROSSBEAM_CALLBACK_BASE_URL=http://127.0.0.1:3001
CROSSBEAM_STALE_RUN_TIMEOUT_MINUTES=60
# Periodic stale-run sweep interval; 0 disables (startup sweep always runs).
CROSSBEAM_STALE_RUN_RECONCILE_INTERVAL_MINUTES=10
CROSSBEAM_MAX_PDF_MB=80
CROSSBEAM_MAX_PLAN_PDF_PAGES=120
CROSSBEAM_MAX_DOCUMENT_PDF_PAGES=80
CROSSBEAM_MAX_DOCUMENT_TEXT_TOTAL_PAGES=160
CROSSBEAM_TITLE_BLOCK_VISION=auto
CROSSBEAM_TITLE_BLOCK_VISION_MODEL=claude-haiku-4-5-20251001
CROSSBEAM_TITLE_BLOCK_VISION_MAX_PAGES=60
CROSSBEAM_TITLE_BLOCK_VISION_TIMEOUT_MS=20000
CROSSBEAM_TITLE_BLOCK_VISION_CONCURRENCY=4
CROSSBEAM_TITLE_BLOCK_VISION_MAX_RETRIES=2

VERCEL_TOKEN=<your Vercel token, still required for Vercel Sandbox runs>
VERCEL_TEAM_ID=<your Vercel team id>
VERCEL_PROJECT_ID=<your Vercel project id>
SANDBOX_TIMEOUT=45m

# Optional local binary overrides. Prefer PATH in production.
# POPPLER_PATH and IMAGEMAGICK_PATH point to directories containing the binaries.
POPPLER_PATH=
IMAGEMAGICK_PATH=

PORT=3001
HOST=127.0.0.1
