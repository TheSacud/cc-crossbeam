ANTHROPIC_API_KEY=your-anthropic-api-key

# Recommended for public VPS deploy: use hosted Supabase, or a hardened
# self-hosted Supabase with unique production secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CROSSBEAM_WORKER_TOKEN=replace-with-the-same-secret-used-by-the-frontend
CROSSBEAM_SANDBOX_CALLBACK_SECRET=replace-with-a-different-long-random-secret
CROSSBEAM_CALLBACK_BASE_URL=https://your-cloud-run-or-server-url
CROSSBEAM_STALE_RUN_TIMEOUT_MINUTES=60
CROSSBEAM_MAX_PDF_MB=80
CROSSBEAM_MAX_PLAN_PDF_PAGES=120
CROSSBEAM_MAX_DOCUMENT_PDF_PAGES=80
CROSSBEAM_MAX_DOCUMENT_TEXT_TOTAL_PAGES=160

VERCEL_TOKEN=your-vercel-token
VERCEL_TEAM_ID=your-vercel-team-id
VERCEL_PROJECT_ID=your-vercel-project-id

# Optional binary overrides when Poppler/ImageMagick are not on PATH.
POPPLER_PATH=
IMAGEMAGICK_PATH=

PORT=3001
HOST=127.0.0.1
